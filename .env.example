# .env.example — скопируйте в .env для локальной разработки
# НЕ коммитьте .env в git!

# Обязательные
SECRET_KEY=замените-на-случайную-строку-минимум-32-символа
DATABASE_PATH=         # Оставьте пустым — будет instance/autoservice.db локально

# Опциональные
FLASK_ENV=development
FLASK_DEBUG=1
LOG_LEVEL=debug
WEB_CONCURRENCY=2

# Администратор по умолчанию (только при первом запуске)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=смените-в-продакшене
